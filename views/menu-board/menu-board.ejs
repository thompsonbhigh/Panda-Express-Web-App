<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Menu Board</title>
    <link rel="stylesheet" href="styles/style.css">
    <link rel="stylesheet" href="styles/menu-board.css">
    <script src="/functions/api/currency-exchange.js" defer></script>
</head>
<body>
    <main>
    <nav class="navbar">
        <a href="/menu-board/sizes">Sizes</a>
        <a href="/menu-board/entrees">Entrees</a>
        <a href="/menu-board/sides-and-a-la-carte">Sides and A La Carte</a>
        <a href="/menu-board/appetizers-and-drinks">Appetizers</a>
    </nav>
    <div class="slide">
        <div class="container">
            <h1>Pick a Meal</h1>
            <table class="size-table">
                <tr>
                    <td class="size">Bowl</td>
                    <td class="menu-price" data-base-price="<%= prices['Bowl'] %>">
                        $<%= prices["Bowl"] %>
                    </td>
                </tr>
                <tr>
                    <td class="sub">1 Entree, 1 Side</td>
                </tr>

                <tr>
                    <td class="size">Plate</td>
                    <td class="menu-price" data-base-price="<%= prices['Plate'] %>">
                        $<%= prices["Plate"] %>
                    </td>
                </tr>
                <tr>
                    <td class="sub">2 Entrees, 1 Side</td>
                </tr>

                <tr>
                    <td class="size">Bigger Plate</td>
                    <td class="menu-price" data-base-price="<%= prices['Bigger Plate'] %>">
                        $<%= prices["Bigger Plate"] %>
                    </td>
                </tr>
                <tr>
                    <td class="sub">3 Entrees, 1 Sides</td>
                </tr>

                <tr><td></td></tr>
                <tr><td></td></tr>
                <tr><td></td></tr>

                <tr>
                    <td class="size">Family Meal</td>
                    <td class="menu-price" data-base-price="<%= prices['Family'] %>">
                        $<%= prices["Family"] %>
                    </td>
                </tr>
                <tr class="sub"><td>3 Large Entrees, 2 Large Sides</td></tr>

                <tr><td></td></tr>
                <tr><td></td></tr>
                <tr><td></td></tr>

                <tr>
                    <td class="size">Cub Meal</td>
                    <td class="menu-price" data-base-price="<%= prices['Kids'] %>">
                        $<%= prices["Kids"] %>
                    </td>
                </tr>
                <tr class="sub">
                    <td>1 Jr. Entree, 1 Jr. Side, Fruit Side, & Bottled Water or Kid's Juice</td>
                </tr>
            </table>
        </div>
    </div>
    <div class="slide">
        <div class="container">
        <h1>Entrees</h1>
        <table class="menu-list">
            <% if (entreeNames && entreeNames.length > 0) { %>
                <% entreeNames.forEach(function(name) { %>
                    <% if (name.category === "Entree" && name.menuitem_name !== "EMPTY") { %>
                        <tr>
                            <td><%= name.full_name %></td>
                            <td><%= name.calories %> cal</td>
                        </tr>
                    <% } %>
                    <% if (name.category === "Premium Entree" && name.menuitem_name !== "EMPTY") { %>
                        <tr>
                            <td>(P) <%= name.full_name %></td>
                            <td><%= name.calories %> cal</td>
                        </tr>
                    <% } %>
                <% }); %>
            <% } %>
        </table>

        <div class="sub" style="text-align:center">
            <p class="sub">(P) Additional Premium Charge:</p>
            Entree: 
            <span class="premium-price" data-base-price="1.50">$1.50</span>,
            Jr. Entree:
            <span class="premium-price" data-base-price="1.00">$1.00</span>,
            Family Meal Entree:
            <span class="premium-price" data-base-price="4.50">$4.50</span>
        </div>
    </div>

    </div>
    <div class="slide">
       <div class="container" style="height: 30vh; margin-bottom: 0vh">
        <h1>Sides</h1>
        <table class="menu-list">
            <% if (entreeNames && entreeNames.length > 0) { %>
                <% entreeNames.forEach(function(name) { %>
                    <% if (name.category === "Side") { %>
                        <tr>
                            <td><%= name.full_name %></td>
                            <td><%= name.calories %> cal</td>
                        </tr>
                    <% } %>
                <% }); %>
            <% } %>
        </table>
    </div>

    <div class="container" style="height: 40vh; margin-top: 0vh">
        <h1>A La Carte Boxes</h1>
        <table class="a-la-carte">
            <tr>
                <th></th>
                <th>Entrees</th>
                <th>Premium</th>
                <th>Sides</th>
            </tr>
            <tr class="sub">
                <td></td>
                <td>150-1530 cal</td>
                <td></td>
                <td>130-1240 cal</td>
            </tr>

            <!-- Small -->
            <tr>
                <td>Sm</td>
                <td>
                    <span class="menu-price" data-base-price="<%= Number(prices['Small'] || 0) %>">
                        $<%= Number(prices['Small'] || 0).toFixed(2) %>
                    </span>
                </td>
                <td>
                    <span class="premium-price" data-base-price="<%= Number(prices['Small'] || 0) + 1.50 %>">
                        $<%= (Number(prices['Small'] || 0) + 1.50).toFixed(2) %>
                    </span>
                </td>
                <td>
                    <span class="menu-price" data-base-price="<%= Number(prices['Small-S'] || 0) %>">
                        $<%= Number(prices['Small-S'] || 0).toFixed(2) %>
                    </span>
                </td>
            </tr>

            <!-- Medium -->
            <tr>
                <td>Med</td>
                <td>
                    <span class="menu-price" data-base-price="<%= Number(prices['Medium'] || 0) %>">
                        $<%= Number(prices['Medium'] || 0).toFixed(2) %>
                    </span>
                </td>
                <td>
                    <span class="premium-price" data-base-price="<%= Number(prices['Medium'] || 0) + 3 %>">
                        $<%= (Number(prices['Medium'] || 0) + 3).toFixed(2) %>
                    </span>
                </td>
                <td>
                    <span class="menu-price" data-base-price="<%= Number(prices['Med-S'] || 0) %>">
                        $<%= Number(prices['Med-S'] || 0).toFixed(2) %>
                    </span>
                </td>
            </tr>

            <!-- Large -->
            <tr>
                <td>Lg</td>
                <td>
                    <span class="menu-price" data-base-price="<%= Number(prices['Large'] || 0) %>">
                        $<%= Number(prices['Large'] || 0).toFixed(2) %>
                    </span>
                </td>
                <td>
                    <span class="premium-price" data-base-price="<%= Number(prices['Large'] || 0) + 4.50 %>">
                        $<%= (Number(prices['Large'] || 0) + 4.50).toFixed(2) %>
                    </span>
                </td>
                <td>
                    <span class="menu-price" data-base-price="<%= Number(prices['Large-S'] || 0) %>">
                        $<%= Number(prices['Large-S'] || 0).toFixed(2) %>
                    </span>
                </td>
            </tr>
        </table>
    </div>
    </div>
    <div class="slide">
        <div class="container" style="height: 25vh; margin-bottom: 0vh">
            <h1>Appetizers</h1>
            <table class="menu-list">
                <% if (entreeNames && entreeNames.length > 0) { %>
                    <% entreeNames.forEach(function(name) { %>
                        <% if (name.category === "Appetizer") { %>
                            <tr>
                                <td><%= name.full_name %></td>
                                <td><%= name.calories %> cal</td>
                                <td class="menu-price" data-base-price="<%= appPrice %>">
                                    $<%= appPrice %>
                                </td>
                            </tr>
                        <% } %>
                    <% }); %>
                <% } %>
            </table>
        </div>

        <div class="container" style="height: 35vh; margin-top: 0vh">
            <h1>Drinks</h1>
            <table class="menu-list">
                <% if (entreeNames && entreeNames.length > 0) { %>
                    <% entreeNames.forEach(function(name) { %>
                        <% if (name.category === "Drink") { %>
                            <tr>
                                <td><%= name.full_name %></td>
                                <td><%= name.calories %> cal</td>
                                <td class="menu-price" data-base-price="<%= drinkPrice %>">
                                    $<%= drinkPrice %>
                                </td>
                            </tr>
                        <% } %>
                    <% }); %>
                <% } %>
            </table>
        </div>
    </div>
    <div style="margin: 20px">
            <label for="currency-selector">Currency:</label>
            <select id="currency-selector">
                <option value="USD" selected>USD</option>
                <option value="EUR">EUR</option>
                <option value="JPY">JPY</option>
                <option value="GBP">GBP</option>
                <option value="CAD">CAD</option>
            </select>

            <p id="exchange-rate">Loading exchange rate...</p>
        </div>
    </main>
    <script>
    document.addEventListener("DOMContentLoaded", () => {
        const containers = document.querySelectorAll(".slide");
        let index = 0;

        // Hide all but the first
        containers.forEach((c, i) => {
            c.style.display = (i === 0 ? "block" : "none");
        });

        setInterval(() => {
            // Hide current
            containers[index].style.display = "none";

            // Move to next, wrap around
            index = (index + 1) % containers.length;

            // Show next
            containers[index].style.display = "block";

        }, 5000); // 5000 ms = 5 seconds per section
    });
</script>
</body>
</html>
