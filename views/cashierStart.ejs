<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="newCashier.js"></script>
    <link rel="stylesheet" href="/styles/newCashier.css">
    <title>Cashier Start</title>
</head>
<body>
    <div class="center-container">
        <form action="../newCashier" method="POST">
            <button class="start-button">START ORDER</button>
        </form>
    </div>
        
    <div class="refill-container">
        <form action="../newCashier/refill" method="POST">
            <label for="refill">Request Refill:</label>
            <select name="refill" id="refill">
                <% rows.forEach(item => { %>
                    <option value="<%=item.menuitem_name%>"><%=item.menuitem_name%></option>
                <% }); %>
            </select>
            <input type="submit" value="Submit">
        </form>
    </div>

    <div>
        <a href="/">Back to Home</a>
    </div>
</body>
</html>