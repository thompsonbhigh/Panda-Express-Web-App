        </script>
    <title>Cashier</title>
</head>
<body>
    <div>
        <a href="/">Back to Home</a>
    </div>
    <div class="kitchengrid">
        <div>
            <table>
                <tr>
                    <th>Order ID</th>
                    <th>Items</th>
                    <th>Size</th>
                    <th></th>
                </tr>
                <% orders.orders.forEach(order => { %>
                    <tr>
                        <td><%= order.order_id %></td>
                        <td><%= order.menuitem %></td>
                        <td><%= order.size %></td>
                        <td>
                            <form action="../kitchen/mark-complete" method="POST">
                                <button type="submit" value="<%= order.order_id %>" name="orderid">Completed</button>
                            </form>
                        </td>
                    </tr>
                    <% }); %>
                </table>
            </div>

            <div>

                <table>
                    <tr>
                        <th>Alerts</th>
                        <th></th>
                    </tr>
                    <% if (verify) { %>
                        <tr>
                            <td>Verification needed!</td>
                        </tr>
                    <% } %>
                    <% if (help) { %>
                        <tr>
                            <td>Help needed!</td>
                            <td>
                                <form action="../kitchen/help-complete" method="POST">
                                    <button type="submit" value="Help" name="Help">Complete</button>
                                </form>
                            </td>
                        </tr>
                    <% } %>
                        </table>
                    </div>
        </div>
</body>
</html>