<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Panda Express</title>
    <link rel="stylesheet" href="styles/style.css">
    <link rel="stylesheet" href="styles/start.css">
    <script src="functions/kiosk/start.js" defer></script>
     <script src="/functions/api/weather.js" defer></script>
    
</head>
<body>
    <div id="transition-overlay" class="transition-overlay exit-mode"></div>

    <div class="header">
        <span class="header-title">Panda Express</span>

        <div id="weather-container">
            <div class="weather-left">
                <p id="weather-temp">--</p>
            </div>

            <div class="weather-right">
                <img id="weather-icon" src="" alt="weather icon">
                <p id="weather-description">--</p>
            </div>
        </div>
    </div>


    <div class="container">
        <h1>Welcome!</h1>
        
        <button class="start-order-btn" onclick="startOrder()"><strong>Start Order</strong></button>
        
        <div class="translate-button" id="google_translate_element"></div>
    
        <script type="text/javascript">
            function googleTranslateElementInit() {
                new google.translate.TranslateElement({pageLanguage: 'en', includedLanguages: ''}, 'google_translate_element');
            }

        </script>
    
        <script type="text/javascript" src="//translate.google.com/translate_a/element.js?cb=googleTranslateElementInit"></script>

    </div>


</body>
</html>