<!DOCTYPE html>
<html lang="en">


<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Employee Verification</title>
    <link rel="stylesheet" href="/styles/style.css">
    <link rel="stylesheet" href="/styles/employee-verify.css">
    <script src="/functions/kiosk/employee-verify.js" defer></script>
</head>
<body>
<div class="header">
    Panda Express
</div>
<div class="container">
    <h1>Please Wait for Assistance</h1>
    <form id="employee-verify-form" onsubmit="return verifyEmployee(event)" autocomplete="off">
        <label for="employee-id">Employee ID:</label>
        <input type="text" id="employee-id" name="employee-id" required>
        <button type="submit" class="verify-btn"><strong>Verify</strong></button>
        <button type="button" class="cancel-btn" onclick="submitCancellation()"><strong>Cancel</strong></button>
    </form>

</div>
</body>
</html>