<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <title>Inventory</title>
        <link rel="stylesheet" href="../styles/managerStyle.css">
    </head>

    <body>
        <%- include("nav_manager.ejs") %>

        <h1>Inventory</h1>
        <table>
            <thead>
                <tr>
                    <th>Item ID</th>
                    <th>Item Name</th>
                    <th>Quantity</th>
                    <th>Unit</th>
                    <th colspan="2">Actions</th>
                </tr>
            </thead>

            <tbody>
                <% inventory.forEach(item => { %> 
                    <tr>
                        <form action="/manager/inventory/update" method="POST">
                            <td>
                                <%= item.item_id %> 
                            </td>
                            <td> 
                                <%= item.item_name %>
                            </td>
                            <td> 
                                <input type="number" step="any" name="quantity" value="<%= item.quantity %>" min="0">
                            </td>
                            <td>
                                <%= item.unit %>
                            </td>
                            <td>
                                <input type="hidden" name="item_id" value="<%= item.item_id %>">
                                <button type="submit"> Save </button>
                            </td>
                        </form>

                        <td>
                            <form action="/manager/inventory/delete" method="POST">
                                <input type="hidden" name="item_id" value="<%= item.item_id %>">
                                <button type="submit" class="delete-btn"> Delete </button>
                            </form>
                        </td>

                    </tr>
                <% }) %>
            </tbody>
        </table> 

        <form action="/manager/inventory/add" method="POST">
            <div>
                <label>Item ID:</label>
                <input type="text" name="item_id">
            </div>
                <label>Item Name:</label>
                <input type="text" name="item_name" required>
            <div>
                <label>Quantity:</label>
                <input type="text" name="quantity" min="0" required>
            </div>
            <div>
                <label>Unit:</label>
                <input type="text" name="unit" required>
            </div>
            <button type="submit">Add Item</button>
        </form>

        <div class="footer">
            Created by Fall 2025 Team 42.
        </div>
        <% if (error) { %>
        <script>
            alert('<%= error %>');
        </script>
        <% } %>
    </body> 
</html>