<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <title>Menu Items</title>
        <link rel="stylesheet" href="../styles/managerStyle.css">
    </head>

    <body>
        <%- include("nav_manager.ejs") %>
        <h1>Menu</h1>
        <table>
            <thead>
                <tr>
                    <th>Menu Item ID</th>
                    <th>Menu Item Name</th>
                    <th>Category</th>
                    <th>Full Name</th>
                    <th>Calories</th>
                    <th colspan="2">Actions</th>
                </tr>
            </thead>

            <tbody>
                <% menu.forEach(item => { %> 
                    <tr>
                        <form action="/manager/menu/update" method="POST">
                            <td>
                                <%= item.menuitem_id %> 
                            </td>
                            <td> 
                                <input type="text" name="menuitem_name" value="<%= item.menuitem_name %>">
                            </td>
                            <td> 
                                <select name="category" required>
                                    <option value="Entree" <%= item.category === 'Entree' ? 'selected' : '' %>>Entree</option>
                                    <option value="Premium Entree" <%= item.category === 'Premium Entree' ? 'selected' : '' %>>Premium Entree</option>
                                    <option value="Side" <%= item.category === 'Side' ? 'selected' : '' %>>Side</option>
                                    <option value="Drink" <%= item.category === 'Drink' ? 'selected' : '' %>>Drink</option>
                                    <option value="Appetizer" <%= item.category === 'Appetizer' ? 'selected' : '' %>>Appetizer</option>
                                </select>
                            </td>
                            <td> 
                                <input type="text" name="full_name" value="<%= item.full_name %>">
                            </td>
                            <td> 
                                <input type="number" name="calories" value="<%= item.calories %>">
                            </td>
                            <td>
                                <input type="hidden" name="menuitem_id" value="<%= item.menuitem_id %>">
                                <button type="submit"> Save </button>
                            </td>
                        </form>

                        <td>
                            <form action="/manager/menu/delete" method="POST">
                                <input type="hidden" name="menuitem_id" value="<%= item.menuitem_id %>">
                                <button type="submit" class="delete-btn"> Delete </button>
                            </form>
                        </td>

                    </tr>
                <% }) %>
            </tbody>
        </table> 

        <form action="/manager/menu/add" method="POST">
            <label>Menu Item ID:</label>
            <input type="text" name="menuitem_id">

            <label>Menu Item Name:</label>
            <input type="text" name="menuitem_name" required>

            <label>Category:</label>
            <select name="category" required>
                <option value="">-- Select Category --</option>
                <option value="Entree">Entree</option>
                <option value="Premium Entree">Premium Entree</option>
                <option value="Side">Side</option>
                <option value="Drink">Drink</option>
                <option value="Appetizer">Appetizer</option>
            </select>

            <label>Full Name:</label>
            <input type="text" name="full_name" required>

            <label>Calories:</label>
            <input type="number" name="calories" required>

            <button type="submit">Add Item</button>
        </form>
        
        <div class="footer">
            Created by Fall 2025 Team 42.
        </div>
        <% if (error) { %>
        <script>
            alert('<%= error %>');
        </script>
        <% } %>
    </body> 
</html>
